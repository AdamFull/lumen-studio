{
    "format": "lumen-filter",
    "version": 1,
    "name": "Sharpen",
    "description": "Makes edges and fine detail crisper.",
    "nodes": [
        {
            "id": "n1",
            "type": "input",
            "x": 0,
            "y": 0
        },
        {
            "id": "n2",
            "type": "unsharp-mask",
            "x": 260,
            "y": 0,
            "params": {
                "amount": 80,
                "radius": 1.5,
                "threshold": 2
            }
        },
        {
            "id": "n3",
            "type": "output",
            "x": 520,
            "y": 0
        }
    ],
    "links": [
        {
            "from": "n1",
            "output": "image",
            "to": "n2",
            "input": "image"
        },
        {
            "from": "n2",
            "output": "image",
            "to": "n3",
            "input": "image"
        }
    ],
    "published": [
        {
            "node": "n2",
            "param": "amount",
            "label": "Amount",
            "min": 0,
            "max": 300
        },
        {
            "node": "n2",
            "param": "radius",
            "label": "Edge width",
            "min": 0.5,
            "max": 10
        }
    ]
}
