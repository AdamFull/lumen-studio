{
  "name": "Part completion (LayerDiffuse, SDXL)",
  "description": "Completes the hidden areas of a character part as a transparent layer. Requires the ComfyUI-layerdiffuse custom nodes (huchenlei) and an SDXL checkpoint (set it as the provider's Checkpoint). For SD 1.5 change the config to \"SD15, Attention Injection, attn_sharing\" and sd_version to \"SD15\".",
  "modes": ["inpaint", "layer_diffuse"],
  "size_multiple": 64,
  "native_resolution": 1024,
  "bindings": {
    "checkpoint": {"node": "1", "input": "ckpt_name"},
    "init_image": {"node": "2", "input": "image"},
    "mask_image": {"node": "4", "input": "image"},
    "prompt": {"node": "8", "input": "text"},
    "negative": {"node": "9", "input": "text"},
    "seed": {"node": "10", "input": "seed"},
    "steps": {"node": "10", "input": "steps"},
    "cfg": {"node": "10", "input": "cfg"},
    "denoise": {"node": "10", "input": "denoise"}
  },
  "workflow": {
    "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}},
    "2": {"class_type": "LoadImage", "inputs": {"image": "context.png"}, "_meta": {"title": "Part context"}},
    "3": {"class_type": "VAEEncode", "inputs": {"pixels": ["2", 0], "vae": ["1", 2]}},
    "4": {"class_type": "LoadImage", "inputs": {"image": "mask.png"}, "_meta": {"title": "Hidden area"}},
    "5": {"class_type": "ImageToMask", "inputs": {"image": ["4", 0], "channel": "red"}},
    "6": {"class_type": "SetLatentNoiseMask", "inputs": {"samples": ["3", 0], "mask": ["5", 0]}},
    "7": {"class_type": "LayeredDiffusionApply", "inputs": {"model": ["1", 0], "config": "SDXL, Conv Injection", "weight": 1.0}},
    "8": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["1", 1]}},
    "9": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["1", 1]}},
    "10": {"class_type": "KSampler", "inputs": {"model": ["7", 0], "seed": 0, "steps": 24, "cfg": 6.0, "sampler_name": "euler_ancestral",
                                                "scheduler": "normal", "positive": ["8", 0], "negative": ["9", 0], "latent_image": ["6", 0], "denoise": 1.0}},
    "11": {"class_type": "VAEDecode", "inputs": {"samples": ["10", 0], "vae": ["1", 2]}},
    "12": {"class_type": "LayeredDiffusionDecodeRGBA", "inputs": {"samples": ["10", 0], "images": ["11", 0], "sd_version": "SDXL", "sub_batch_size": 16}},
    "13": {"class_type": "PreviewImage", "inputs": {"images": ["12", 0]}, "_meta": {"title": "Transparent part"}}
  }
}
