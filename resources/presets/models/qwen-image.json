  "presets": [
    {
      "id": "qwen-image-edit",
      "name": "Qwen-Image-Edit",
      "type": "qwen-image",
      "note": "A large model (20B): realistic with 16 GB of graphics memory or more.",
      "docs": "https://github.com/leejet/stable-diffusion.cpp/blob/f89d9b13d730eabeede7314ce49dacd18d3c90c2/docs/qwen_image_edit.md",
      "match": {"family": "Qwen-Image", "kinds": ["diffusion_model"], "name_any": ["edit"]},
      "slots": [
        {"option": "vae", "kind": "vae", "family": "Qwen-Image / Wan", "label": "Qwen-Image VAE", "file": "qwen-image-vae"},
        {"option": "llm", "kind": "text_encoder", "family": "LLM", "variant": "Qwen2.5 7B", "label": "Qwen2.5-VL 7B text encoder", "file": "qwen25-vl-7b"}
      ],
      "can": {"generate": false, "edit": true, "inpaint": true, "references": 3, "negative_prompt": true, "loras": true, "control_net": [], "ip_adapter": []},
      "sampling": {"cfg": 2.5, "flow_shift": 3, "sampler": "euler", "native_resolution": 1024, "dialect": "natural"}
    },
    {
      "id": "qwen-image",
      "name": "Qwen-Image",
      "type": "qwen-image",
      "note": "A large model (20B): realistic with 16 GB of graphics memory or more.",
      "match": {"family": "Qwen-Image", "kinds": ["diffusion_model"]},
      "slots": [
        {"option": "vae", "kind": "vae", "family": "Qwen-Image / Wan", "label": "Qwen-Image VAE", "file": "qwen-image-vae"},
        {"option": "llm", "kind": "text_encoder", "family": "LLM", "variant": "Qwen2.5 7B", "label": "Qwen2.5-VL 7B text encoder", "file": "qwen25-vl-7b"}
      ],
      "can": {"generate": true, "edit": false, "inpaint": true, "negative_prompt": true, "loras": true, "control_net": [], "ip_adapter": []},
      "sampling": {"cfg": 2.5, "flow_shift": 3, "sampler": "euler", "native_resolution": 1024, "dialect": "natural"}
    }
  ]
